# --- LLM (required) ---
# "anthropic" (default, recommended) or "deepseek"
LLM_PROVIDER=anthropic

# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Only needed if LLM_PROVIDER=deepseek. Get this from https://platform.deepseek.com/api_keys
# NEVER paste a real key into a chat message, a screenshot, or a public repo —
# treat it exactly like a password. Put it here, in .env, which is gitignored.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# --- Twilio WhatsApp (required for the live channel) ---
# Get these from https://console.twilio.com (Account SID + Auth Token on the dashboard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Leave as-is for the shared Sandbox number; change only if you move to a real WhatsApp Business number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Set to false ONLY for local testing without a real Twilio signature (e.g. curl/Postman tests)
TWILIO_VALIDATE_SIGNATURE=true

# --- Business config ---
BUSINESS_NAME=Alpha Fitness
BUSINESS_WHATSAPP=+254718040612
BUSINESS_WEBSITE=https://alphafitness.co.ke
# Optional: a WhatsApp number (that has also joined the Twilio sandbox) to auto-notify on human handoff
HUMAN_ESCALATION_WHATSAPP=

# --- Storage / data ---
DATABASE_PATH=data/leads.db
CATALOGUE_PATH=data/catalogue/products.json
SITE_INFO_PATH=data/site_info.json

# --- Safety ---
# The live-fetch tool refuses any URL outside this domain
ALLOWED_FETCH_DOMAIN=alphafitness.co.ke

# Per-contact rate limit — protects the LLM bill from one runaway sender
RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=3600
